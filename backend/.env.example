# Salin file ini menjadi .env lalu sesuaikan nilainya.
PORT=3000
NODE_ENV=development

# WAJIB diganti di production. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-yang-panjang
JWT_EXPIRES_IN=7d

# Lokasi file database SQLite
DB_PATH=./data/belajarkuy.db

# Isi bila frontend di-host di domain lain (pisahkan dengan koma). Kosongkan bila sama-origin.
CORS_ORIGIN=

# Akun demo (aktif secara default, cocok untuk portofolio). Dibuat otomatis, datanya
# diisi ulang tiap hari dari frontend/demo-data.json, dan tombol "Coba akun demo"
# muncul di landing page & halaman login. Kredensialnya bersifat PUBLIK.
# Isi false untuk mematikannya (mis. bila dipakai pengguna sungguhan).
DEMO_MODE=true
DEMO_TIMEZONE=Asia/Jakarta
DEMO_EMAIL=demo@belajarkuy.com
DEMO_PASSWORD=demo12345
